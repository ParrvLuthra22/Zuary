# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres, pooled connection string.
DATABASE_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/zuary?sslmode=require"

# Razorpay API key pair — Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Razorpay webhook signing secret — Dashboard → Settings → Webhooks.
# Separate from the API secret above.
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Public key id, used as a fallback when Razorpay checkout opens client-side.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Canonical origin, used for metadata and absolute URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Auth.js ──────────────────────────────────────────────────────────────
# Signing/encryption key for the session JWT. Generate with:
#   npx auth secret
# Rotating this invalidates every existing session.
AUTH_SECRET=""

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials.
# Authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google   (and the production origin)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend API key, for magic links — resend.com/api-keys
AUTH_RESEND_KEY=""

# Sender for magic links. The domain must be verified in Resend or delivery
# fails silently into spam.
EMAIL_FROM="ZUARY <hello@zuary.in>"

# Comma-separated allowlist. Any of these addresses is promoted to the admin
# role in the database on sign-in. Parsed once per process, so changes need a
# redeploy — deliberate friction for granting admin.
ADMIN_EMAILS="you@example.com"

# Vercel Blob, for admin product-image upload. Not read until that ships.
BLOB_READ_WRITE_TOKEN=""

# ── Rate limiting (Upstash Redis) ────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without these the limiter falls back to an in-memory
# Map, which on serverless resets every cold start — effectively no limit at all.
# console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Phone OTP ────────────────────────────────────────────────────────────
# Off until DLT registration with TRAI completes (1-2 weeks via MSG91). With it
# false the code is logged to the server console instead of sent, and no phone
# option renders on /login.
ENABLE_PHONE_OTP="false"

# MSG91, once DLT registration is approved. The template id must be the
# registered one — an unregistered template is rejected by the operator and
# repeated attempts put the sender id at risk.
MSG91_AUTH_KEY=""
MSG91_DLT_TEMPLATE_ID=""
